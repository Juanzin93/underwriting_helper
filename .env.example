# UW Helper configuration example. Copy to `.env` (never commit `.env`) or set the same names as
# environment variables. Precedence: defaults < %LOCALAPPDATA%\UWHelper\uwhelper.toml < .env < environment.
# Only UWH_* keys are read. No secrets are required for core features.

# Where data lives (default: %LOCALAPPDATA%\UWHelper). Keep it OUT of OneDrive/Dropbox and out of the repo.
# UWH_DATA_DIR=C:\Users\you\AppData\Local\UWHelper
# Optional explicit locations (default: inside UWH_DATA_DIR)
# UWH_DB_FILE=D:\EncryptedVolume\uwhelper\uwhelper.db
# UWH_DOCUMENTS_PATH=D:\EncryptedVolume\uwhelper\documents

# Web server — loopback only. Non-loopback hosts are refused unless UWH_ALLOW_NON_LOOPBACK_BIND=1 (not recommended).
UWH_HOST=127.0.0.1
UWH_PORT=8765

# Local LLM (must be a loopback URL; cloud models such as "...:cloud" are refused)
UWH_OLLAMA_URL=http://127.0.0.1:11434
UWH_OLLAMA_MODEL=qwen3:8b
# UWH_OLLAMA_TIMEOUT_SECONDS=180
# UWH_OLLAMA_NUM_CTX=8192
# UWH_OLLAMA_HEALTH_TIMEOUT_SECONDS=2

# OCR (optional). Leave as "tesseract" if it is on PATH.
# UWH_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# UWH_TESSERACT_LANG=eng

# Uploads and database
UWH_MAX_UPLOAD_MB=50
# UWH_MAX_PAGES=300
# UWH_DB_BUSY_TIMEOUT_MS=30000
# UWH_LOG_LEVEL=INFO
# Name shown as "recorded by" on audit events, history, tasks and notes (default: your Windows account name).
# Attribution only — not a login.
# UWH_ACTOR_NAME=Jane Broker

# Optional external integrations — OFF. Both settings are required to enable a named integration.
# None are implemented yet; see docs/ROADMAP.md (Milestone 8).
UWH_EXTERNAL_INTEGRATIONS_ALLOWED=false
UWH_ENABLED_INTEGRATIONS=
